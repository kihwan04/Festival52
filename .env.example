# Server-only Supabase connection values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Shared HMAC secret stored in Sites and Supabase Vault (32+ random bytes)
FESTIVAL_REQUEST_SIGNING_SECRET=

# National Institute of Korean Language Korean Basic Dictionary Open API key.
# Keep it server-only in Sites runtime variables; never expose it to browsers.
FESTIVAL_KRDICT_API_KEY=

# Canonical deployed origin. Used for auth redirects and social metadata; no path.
FESTIVAL_PUBLIC_ORIGIN=https://festival-52-qr-order.rlghks12291.chatgpt.site

# Self-service operator creation is locked by default. Enable only briefly when
# a new trusted operating team is intentionally being provisioned.
FESTIVAL_ALLOW_SIGNUP=false

# Local presentation mode only. Production ignores this even if misconfigured.
FESTIVAL_DEMO_MODE=false
